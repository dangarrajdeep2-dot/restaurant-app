# ─── Firebase Web App Configuration ───────────────────────────────────────────
# Get these credentials from your Firebase Console (Project Settings > General > Your Apps)
# When these are left empty or set to demo-project, the app runs in full offline demo mode
# with reactive cross-tab multi-user synchronization.

VITE_FIREBASE_API_KEY=AIzaSyDemoAPIKeyForSpiceGarden
VITE_FIREBASE_AUTH_DOMAIN=spice-garden-restaurant.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=spice-garden-restaurant
VITE_FIREBASE_STORAGE_BUCKET=spice-garden-restaurant.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
